// A value held between the braces of the NCode mark. The braces are the mark's own drawing, taken
// from the vendored logo file: a font's braces differ from them, and the logo kit rules those out.
import mark from '../../vendor/brand/logo/ncode/mark/ncode-mark-blue.svg?raw';

// The mark is one path of three closed shapes: the left brace, the letter, the right brace.
const shapes = (/\sd="([^"]+)"/.exec(mark)?.[1] ?? '').split('Z').filter(Boolean).map((shape) => `${shape}Z`);
const [left, , right] = shapes;
---

<span class="ncode-braces not-content">
  <svg class="ncode-braces__brace" viewBox="4 8 12 48" aria-hidden="true"><path d={left}></path></svg>
  <span class="ncode-braces__value"><slot /></span>
  <svg class="ncode-braces__brace" viewBox="48 8 12 48" aria-hidden="true"><path d={right}></path></svg>
</span>
