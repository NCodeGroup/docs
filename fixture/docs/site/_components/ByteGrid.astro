---
// The fixture's own component: a row of bytes on a screen, some of them zeroed. A library keeps a
// component like this beside its pages and imports it as '@site/components/ByteGrid.astro'.
interface Props {
  /** The bytes, as hexadecimal pairs separated by spaces. */
  bytes: string;
  /** How many of them, from the start, are already zeroed. */
  zeroed?: number;
  /** What the grid shows, for a reader who cannot see it. */
  label: string;
}
const { bytes, zeroed = 0, label } = Astro.props;
const cells = bytes.trim().split(/\s+/);
---

<div class="byte-grid not-content" role="img" aria-label={label}>
  {cells.map((value, index) => <span class:list={['byte-grid__cell', index < zeroed && 'byte-grid__cell--zero']}>{index < zeroed ? '00' : value}</span>)}
</div>

<style>
  .byte-grid {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.375rem;
    padding: 1rem;
    border-radius: var(--radius-panel);
    background: var(--color-screen);
  }
  .byte-grid__cell {
    display: grid;
    place-items: center;
    height: 2.25rem;
    border-radius: var(--radius-cell);
    background: var(--color-screen-raised);
    color: var(--color-screen-hot);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }
  .byte-grid__cell--zero {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-screen-border);
    color: var(--color-on-screen-muted);
  }
</style>
