{
  "name": "@ncodegroup/docs",
  "private": true,
  "type": "module",
  "description": "The shared documentation toolchain for NCode libraries: Astro Starlight, the NCode theme, the sample and link plugins, and the reusable GitHub Pages workflow.",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "build": "node scripts/site.mjs build fixture",
    "site": "node scripts/site.mjs",
    "dev": "node scripts/site.mjs dev",
    "preview": "node scripts/site.mjs preview",
    "check:vendor": "node scripts/check-vendor.mjs",
    "browser": "playwright-core install --only-shell chromium",
    "test": "node --test --test-concurrency=1 --experimental-test-coverage \"--test-coverage-exclude=.work/**\" \"--test-coverage-exclude=test/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/*.test.mjs\"",
    "lint": "biome ci --error-on-warnings .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.9",
    "@astrojs/starlight": "0.42.11",
    "astro": "7.4.11",
    "shiki": "4.6.0",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "playwright-core": "1.65.0"
  }
}
