# Exact versions in package.json: the manifest and the lockfile name the same release.
save-exact=true
# npm resolves only versions at least three days old, the window Dependabot's cooldown states.
# npm ci installs what the lockfile names and doesn't apply it.
min-release-age=3
# Stops an npm older than 11.10, which would ignore min-release-age without a word.
engine-strict=true
