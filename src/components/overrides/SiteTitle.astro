---
// The header's brand: the NCode lockup (the mark's braces and the wordmark), a rule, and the
// product's name. An override because Starlight's own site title is an image or a line of text, and
// the lockup must take its colour from the theme's --color-logo token: it is drawn inline, from the
// vendored file, without that file's own colour.
import { site } from 'virtual:ncode-docs/site';
import ncode from '../../../vendor/instrument/logos/ncode-lockup.svg?raw';
import identity from '../../../vendor/instrument/logos/ncode-identity-lockup.svg?raw';

const { siteTitleHref } = Astro.locals.starlightRoute;
const source = site.mark === 'ncode-identity' ? identity : ncode;
const attribute = (name: string) => new RegExp(`\\s${name}="([^"]+)"`).exec(source)?.[1];
// The Identity lockup already names its product.
const showProduct = site.mark === 'ncode' || site.product !== site.title;
---

<a href={siteTitleHref} class="site-title ncode-brand">
  <svg class="ncode-logo" viewBox={attribute('viewBox')} role="img" aria-label={attribute('aria-label')}>
    <path d={attribute('d')}></path>
  </svg>
  {showProduct && <span class="ncode-brand__product" translate="no">{site.product}</span>}
</a>
