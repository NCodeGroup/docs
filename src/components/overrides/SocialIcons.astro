// The header's tools: the version on a readout, and each of the library's links as a key with its
// name on it. An override because Starlight's own links are icons from a closed set, which has no
// NuGet mark, and because it has no place for a version.
import { site } from 'virtual:ncode-docs/site';
---

{site.version && (
  <span class="ncode-readout" title="Version">
    <span class="sr-only">Version </span>{site.version}
  </span>
)}
{site.social.map(({ label, href }) => (
  <a class="ncode-key" href={href} rel="me">
    {label}
    <svg class="ncode-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" /></svg>
  </a>
))}
