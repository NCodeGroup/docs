{
  "$schema": "vscode://schemas/color-theme",
  "$description": "The syntax theme of a code block on a screen, NCode Brand 0.12.0, as a VS Code color theme for Expressive Code. Each color is the var() of a screen role of tokens/tokens.css: keywords screen-lit, types and members on-screen, comments on-screen-muted, literals screen-hot and the rest on-screen-secondary. Load it on a page that loads tokens/tokens.css, and turn off Expressive Code's contrast correction, which cannot compute with a custom property. A screen is the same in both themes, so one theme serves both. editor.background and editor.foreground are the screen and its ink for NCode's own brand: Expressive Code reads them to load a theme. Generated by build.mjs from src/tokens.source.json and lib/syntax.mjs; do not edit it.",
  "name": "instrument-screen",
  "type": "dark",
  "colors": {
    "editor.background": "#0A1F5C",
    "editor.foreground": "#C2D2FF"
  },
  "tokenColors": [
    {
      "scope": [
        "source",
        "text"
      ],
      "settings": {
        "foreground": "var(--nc-color-on-screen-secondary)"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "var(--nc-color-on-screen-muted)"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "variable.language",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "var(--nc-color-screen-lit)"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.function",
        "entity.name.tag",
        "support.type",
        "support.class",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "var(--nc-color-on-screen)"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language",
        "constant.character",
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "var(--nc-color-screen-hot)"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "var(--nc-color-screen-lit)"
      }
    },
    {
      "scope": [
        "string.unquoted",
        "source.shell string.unquoted"
      ],
      "settings": {
        "foreground": "var(--nc-color-on-screen)"
      }
    }
  ]
}
